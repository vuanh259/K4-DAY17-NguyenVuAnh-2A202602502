# Copy this file to .env and fill it locally. Never commit .env or send keys in chat.
# 1 = model-driven extraction, summary and answers. 0 = offline simulation.
LLM_LIVE=1

# Pick ONE: openai, custom, gemini, anthropic, ollama, openrouter
LLM_PROVIDER=gemini
# Required: exact model ID available in your provider account / local Ollama.
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_API_KEY=
# Only needed for custom endpoint or non-default server:
LLM_BASE_URL=

COMPACT_THRESHOLD_TOKENS=1200
COMPACT_KEEP_MESSAGES=4
MEMORY_MIN_CONFIDENCE=0.85
SUMMARY_BUDGET_TOKENS=300
# Optional decay: 0 disables it for the main benchmark; e.g. 64 enables it.
MEMORY_HALF_LIFE_TURNS=0
MEMORY_MIN_WEIGHT=0.125

# Optional: used only with --judge. Omit to use the selected model/provider.
# JUDGE_PROVIDER=
# JUDGE_MODEL=
# JUDGE_API_KEY=
# JUDGE_BASE_URL=
# JUDGE_TEMPERATURE=0
